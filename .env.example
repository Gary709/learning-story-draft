# Copy to .env if you want the model to write the paragraphs. Never commit a real key.
# When OPENAI_API_KEY is empty or unset, the draft is filled from the word list.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional. Leave unset for https://api.openai.com/v1
# OPENAI_BASE_URL=

# Server port. The Vite dev server proxies /api to this port.
PORT=8787
